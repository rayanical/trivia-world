# Frontend (Vercel). Only the socket URL is public.
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Use the same random server-only value on Vercel and Render.
PROXY_SHARED_SECRET=

# Backend (Render). Keep all of these server-side.
DATABASE_URL=postgresql://localhost/trivia_world
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Trivia World <accounts@your-verified-domain.example>"
PORT=3001

# Optional Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_TRUSTED_ORIGINS=
